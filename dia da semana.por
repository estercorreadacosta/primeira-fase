programa {
  funcao inicio() {
        inteiro dia

  escreva("Digite um número de 1 a 7: ")
   leia(dia)

  se (dia == 1) 
  {
  escreva("1 = Domingo")
 }
 senao se (dia == 2) 
  {
  escreva("2 = Segunda-feira")
  }
 senao se (dia == 3) 
  {
  escreva("3 = Terça-feira")
  }
  senao se (dia == 4) 
  {
  escreva("4 = Quarta-feira")
 }
  senao se (dia == 5) 
 {
  escreva("5 = Quinta-feira")
  }
  senao se (dia == 6) 
 {
  escreva("6 = Sexta-feira")
 }
  senao se (dia == 7) 
 {
  escreva("7 = Sábado")
 }
  senao 
 {
 escreva("Número inválido! Digite um valor entre 1 e 7.")
 }
    }
}

  

