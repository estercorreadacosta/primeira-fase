programa {
  funcao inicio() {
    inteiro idade
cadeia nome
    escreva("qual é a sua idade: ")
    leia(idade)
    escreva("seu nome: ")
leia( nome)
    se(idade < 18){
escreva("você é menor, pode entrar.")
    }
    se(idade >= 18){
      escreva("Você não é menor, não pode entrar.")
      escreva("\nEncontre um menor responsável")
    }
    se(nome== "ester"){
      escreva("\nvoce pode entrar escondido...")
    }
    se(nome != "joana"){
      escreva("\nvocê não aparece nos créditos.")
    }
    se(idade > 50){
escreva("\naqui não pode, mas tenho uma site de dorama...")
    }
    se(idade <= 25){
      escreva("\nse voce estiver com fantasia de cachorro, pode entrar")
    }
    se(idade ==30){
      escreva("\nvoce pode criar uma banda hoje")
    }senao{

    }escreva("\nvolte semana que vem")
  }
}
