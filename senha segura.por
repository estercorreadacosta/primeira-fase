programa {inclua biblioteca Texto --> tx
  funcao inicio() {
	
cadeia senha
		
escreva("Crie uma senha (mínimo 8 caracteres): ")
leia(senha)

// conta quantos caracteres a senha tem
se (tx.numero_caracteres(senha) >= 8) 
{
escreva("Senha criada com sucesso.")
}
senao 
{
escreva(" A senha precisa ter pelo menos 8 caracteres.")
		}
	}
}


  

